{%- comment -%}
  BLS BUILDER — Build Your Own Base Layer Set (UK)
  Matches US (merino.tech) visual design with hover animations,
  per-card size dropdown + "Add to Bundle" button.
{%- endcomment -%}

{%- liquid
  assign col_top = section.settings.collection_top
  assign col_bottom = section.settings.collection_bottom
  assign types_top = section.settings.types_top | downcase | split: ','
  assign types_bottom = section.settings.types_bottom | downcase | split: ','
  assign disc = section.settings.discount_percent
  assign uid = section.id
-%}

<style>
  .bls{--bls-ink:#111;--bls-muted:#6b7280;--bls-line:#e5e7eb;--bls-bg:#fff;--bls-soft:#f7f7f5;--bls-accent:#111;--bls-good:#1f7a4d;--bls-radius:10px;color:var(--bls-ink);}
  .bls *{box-sizing:border-box;}
  .bls__wrap{max-width:1280px;margin:0 auto;padding:28px 16px 56px;}
  .bls__title{font-size:clamp(24px,3vw,36px);line-height:1.15;margin:0 0 6px;text-align:center;font-weight:800;text-transform:uppercase;}
  .bls__sub{margin:0 auto 28px;text-align:center;color:var(--bls-muted);max-width:60ch;}

  /* Step progress bar */
  .bls__steps{display:flex;justify-content:center;align-items:center;margin:0 auto 32px;max-width:600px;position:relative;}
  .bls__step{display:flex;flex-direction:column;align-items:center;gap:6px;position:relative;z-index:1;flex:1;}
  .bls__step b{width:32px;height:32px;border-radius:50%;border:2px solid var(--bls-line);display:grid;place-items:center;font-weight:700;font-size:14px;background:var(--bls-bg);transition:background .2s,border-color .2s,color .2s;}
  .bls__step span{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--bls-muted);font-weight:600;transition:color .2s;}
  .bls__step.is-done b,.bls__step.is-active b{background:var(--bls-accent);color:#fff;border-color:var(--bls-accent);}
  .bls__step.is-active span{color:var(--bls-ink);}
  .bls__step.is-done span{color:var(--bls-ink);}
  .bls__step-line{flex:1;height:2px;background:var(--bls-line);position:relative;top:-10px;z-index:0;transition:background .2s;}
  .bls__step-line.is-done{background:var(--bls-accent);}

  /* Main grid */
  .bls__grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:32px;align-items:start;}
  .bls__panel{padding-top:20px;margin-bottom:34px;}
  .bls__panel-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--bls-line);}
  .bls__panel-badge{display:inline-flex;align-items:center;gap:6px;background:var(--bls-accent);color:#fff;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:5px 12px;border-radius:5px;}
  .bls__panel-head h3{margin:0;font-size:18px;font-weight:700;text-transform:uppercase;}
  .bls__panel-note{font-size:13px;color:var(--bls-muted);margin-left:auto;}

  /* Product cards */
  .bls__products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;}
  .bls__card{border:1px solid var(--bls-line);border-radius:var(--bls-radius);background:var(--bls-bg);overflow:hidden;text-align:left;color:inherit;transition:transform .25s ease,box-shadow .25s ease;}
  .bls__card:hover{transform:translateY(-4px);box-shadow:0 8px 24px rgba(0,0,0,.1);}
  .bls__card[data-picked="true"]{border-color:var(--bls-accent);box-shadow:inset 0 0 0 1px var(--bls-accent);}
  .bls__card-img-wrap{overflow:hidden;background:var(--bls-soft);}
  .bls__card-img-wrap img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;transition:transform .4s ease;}
  .bls__card:hover .bls__card-img-wrap img{transform:scale(1.05);}
  .bls__card-body{padding:12px 14px 16px;display:flex;flex-direction:column;gap:6px;}
  .bls__card-name{font-size:13px;line-height:1.35;font-weight:500;}
  .bls__card-price{font-size:14px;font-weight:700;}
  .bls__card-select{width:100%;padding:9px 10px;border:1px solid var(--bls-line);border-radius:6px;font:inherit;font-size:13px;background:var(--bls-bg);cursor:pointer;appearance:auto;}
  .bls__card-btn{width:100%;padding:11px 10px;border:0;border-radius:6px;background:var(--bls-accent);color:#fff;font:inherit;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;cursor:pointer;transition:background .15s;}
  .bls__card-btn:hover{background:#000;}
  .bls__card-btn:disabled{opacity:.4;cursor:not-allowed;}

  /* Summary panel */
  .bls__summary{position:sticky;top:100px;border:1px solid var(--bls-line);border-radius:var(--bls-radius);padding:20px;background:var(--bls-bg);}
  .bls__summary h3{margin:0 0 14px;font-size:17px;font-weight:800;text-transform:uppercase;}
  .bls__slot{display:flex;gap:12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--bls-line);}
  .bls__slot img{width:56px;height:72px;object-fit:cover;border-radius:6px;background:var(--bls-soft);}
  .bls__slot-body{flex:1;min-width:0;}
  .bls__slot-title{font-size:13px;line-height:1.35;}
  .bls__slot-meta{font-size:12px;color:var(--bls-muted);}
  .bls__slot-remove{border:0;background:none;font:inherit;font-size:12px;color:var(--bls-muted);text-decoration:underline;cursor:pointer;padding:0;}
  .bls__slot.is-empty .bls__slot-title{color:var(--bls-muted);}
  .bls__totals{margin:16px 0;font-size:14px;}
  .bls__row{display:flex;justify-content:space-between;padding:5px 0;}
  .bls__row--save{color:var(--bls-good);font-weight:600;}
  .bls__row--total{font-size:17px;font-weight:700;border-top:1px solid var(--bls-line);margin-top:8px;padding-top:12px;}
  .bls__was{color:var(--bls-muted);text-decoration:line-through;font-weight:400;margin-right:8px;}
  .bls__add{width:100%;padding:15px;border:0;border-radius:8px;background:var(--bls-accent);color:#fff;font:inherit;font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:.04em;cursor:pointer;transition:background .15s;}
  .bls__add:hover:not([disabled]){background:#000;}
  .bls__add[disabled]{opacity:.4;cursor:not-allowed;}
  .bls__done{margin:10px 0 0;font-size:13px;color:var(--bls-good);text-align:center;}
  .bls__done[hidden]{display:none;}
  .bls__perks{list-style:none;margin:16px 0 0;padding:0;font-size:12px;color:var(--bls-muted);display:grid;gap:6px;}
  .bls__empty{padding:24px;border:1px dashed var(--bls-line);border-radius:var(--bls-radius);color:var(--bls-muted);font-size:14px;}

  @media (max-width:1024px){.bls__grid{grid-template-columns:1fr;}.bls__summary{position:static;}}
  @media (max-width:640px){.bls__products{grid-template-columns:repeat(2,minmax(0,1fr));}.bls__wrap{padding:20px 12px 40px;}}
  @media (prefers-reduced-motion:reduce){.bls *{transition:none!important;}}
</style>

<section class="bls" id="bls-{{ uid }}" data-discount="{{ disc }}" data-code="{{ section.settings.discount_code | escape }}" data-bundle="{{ section.settings.bundle_tag | escape }}">
  <div class="bls__wrap">

    <h1 class="bls__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="bls__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="bls__steps">
      <div class="bls__step is-active" data-step="1"><b>1</b><span>{{ section.settings.step1_label }}</span></div>
      <div class="bls__step-line" data-line="1"></div>
      <div class="bls__step" data-step="2"><b>2</b><span>{{ section.settings.step2_label }}</span></div>
      <div class="bls__step-line" data-line="2"></div>
      <div class="bls__step" data-step="3"><b>3</b><span>{{ section.settings.step3_label }}</span></div>
    </div>

    <div class="bls__grid">
      <div>
        {%- comment -%} ---------- STEP 1: TOP ---------- {%- endcomment -%}
        <div class="bls__panel" data-group="top">
          <div class="bls__panel-head">
            <span class="bls__panel-badge">Step 1</span>
            <h3>{{ section.settings.step1_title }}</h3>
            <span class="bls__panel-note" data-selected-note>{{ section.settings.not_selected_text }}</span>
          </div>

          {%- assign top_count = 0 -%}
          <div class="bls__products">
            {%- for product in col_top.products limit: 50 -%}
              {%- assign match = false -%}
              {%- if section.settings.types_top == blank -%}
                {%- assign match = true -%}
              {%- else -%}
                {%- assign ptype = product.type | downcase -%}
                {%- for t in types_top -%}
                  {%- assign needle = t | strip -%}
                  {%- if needle != blank and ptype contains needle -%}{%- assign match = true -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {%- if match and product.available -%}
                {%- assign top_count = top_count | plus: 1 -%}
                <div class="bls__card"
                     data-product
                     data-group-name="top"
                     data-title="{{ product.title | escape }}"
                     data-image="{{ product.featured_image | image_url: width: 200 }}">
                  <div class="bls__card-img-wrap">
                    {%- if product.featured_image -%}
                      <img src="{{ product.featured_image | image_url: width: 400 }}"
                           srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w"
                           sizes="(max-width:640px) 45vw, 20vw"
                           alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="400" height="533">
                    {%- else -%}
                      <img src="{{ 'product-1' | placeholder_svg_tag }}" alt="" width="400" height="533">
                    {%- endif -%}
                  </div>
                  <div class="bls__card-body">
                    <div class="bls__card-name">{{ product.title }}</div>
                    <div class="bls__card-price">{{ product.price | money }}</div>
                    <select class="bls__card-select" data-size-select>
                      <option value="">{{ section.settings.size_label }}</option>
                      {%- for v in product.variants -%}
                        <option value="{{ v.id }}" data-price="{{ v.price }}" {% unless v.available %}disabled{% endunless %}>
                          {{- v.title -}}{% unless v.available %} — Sold out{% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                    <button type="button" class="bls__card-btn" data-add-to-bundle disabled>{{ section.settings.add_bundle_text }}</button>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if top_count == 0 -%}
            <p class="bls__empty">{{ section.settings.empty_text }}</p>
          {%- endif -%}
        </div>

        {%- comment -%} ---------- STEP 2: BOTTOM ---------- {%- endcomment -%}
        <div class="bls__panel" data-group="bottom">
          <div class="bls__panel-head">
            <span class="bls__panel-badge">Step 2</span>
            <h3>{{ section.settings.step2_title }}</h3>
            <span class="bls__panel-note" data-selected-note>{{ section.settings.not_selected_text }}</span>
          </div>

          {%- assign bottom_count = 0 -%}
          <div class="bls__products">
            {%- for product in col_bottom.products limit: 50 -%}
              {%- assign match = false -%}
              {%- if section.settings.types_bottom == blank -%}
                {%- assign match = true -%}
              {%- else -%}
                {%- assign ptype = product.type | downcase -%}
                {%- for t in types_bottom -%}
                  {%- assign needle = t | strip -%}
                  {%- if needle != blank and ptype contains needle -%}{%- assign match = true -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              {%- if match and product.available -%}
                {%- assign bottom_count = bottom_count | plus: 1 -%}
                <div class="bls__card"
                     data-product
                     data-group-name="bottom"
                     data-title="{{ product.title | escape }}"
                     data-image="{{ product.featured_image | image_url: width: 200 }}">
                  <div class="bls__card-img-wrap">
                    {%- if product.featured_image -%}
                      <img src="{{ product.featured_image | image_url: width: 400 }}"
                           srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w"
                           sizes="(max-width:640px) 45vw, 20vw"
                           alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="400" height="533">
                    {%- else -%}
                      <img src="{{ 'product-1' | placeholder_svg_tag }}" alt="" width="400" height="533">
                    {%- endif -%}
                  </div>
                  <div class="bls__card-body">
                    <div class="bls__card-name">{{ product.title }}</div>
                    <div class="bls__card-price">{{ product.price | money }}</div>
                    <select class="bls__card-select" data-size-select>
                      <option value="">{{ section.settings.size_label }}</option>
                      {%- for v in product.variants -%}
                        <option value="{{ v.id }}" data-price="{{ v.price }}" {% unless v.available %}disabled{% endunless %}>
                          {{- v.title -}}{% unless v.available %} — Sold out{% endunless %}
                        </option>
                      {%- endfor -%}
                    </select>
                    <button type="button" class="bls__card-btn" data-add-to-bundle disabled>{{ section.settings.add_bundle_text }}</button>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if bottom_count == 0 -%}
            <p class="bls__empty">{{ section.settings.empty_text }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ---------- SUMMARY ---------- {%- endcomment -%}
      <aside class="bls__summary">
        <h3>{{ section.settings.summary_title }}</h3>

        <div class="bls__slot is-empty" data-slot="top">
          <img alt="" data-slot-img src="{{ 'product-1' | placeholder_svg_tag }}">
          <div class="bls__slot-body">
            <div class="bls__slot-title" data-slot-title>{{ section.settings.slot_top_empty }}</div>
            <div class="bls__slot-meta" data-slot-meta></div>
          </div>
          <button type="button" class="bls__slot-remove" data-slot-remove hidden>{{ section.settings.remove_text }}</button>
        </div>

        <div class="bls__slot is-empty" data-slot="bottom">
          <img alt="" data-slot-img src="{{ 'product-1' | placeholder_svg_tag }}">
          <div class="bls__slot-body">
            <div class="bls__slot-title" data-slot-title>{{ section.settings.slot_bottom_empty }}</div>
            <div class="bls__slot-meta" data-slot-meta></div>
          </div>
          <button type="button" class="bls__slot-remove" data-slot-remove hidden>{{ section.settings.remove_text }}</button>
        </div>

        <div class="bls__totals">
          <div class="bls__row"><span>{{ section.settings.subtotal_text }}</span><span data-subtotal>—</span></div>
          <div class="bls__row bls__row--save"><span>{{ section.settings.discount_text }}</span><span data-savings>−{{ disc }}%</span></div>
          <div class="bls__row bls__row--total"><span>{{ section.settings.total_text }}</span><span data-total>—</span></div>
        </div>

        <button type="button" class="bls__add" data-add disabled>{{ section.settings.cta_text }}</button>
        <p class="bls__done" data-done hidden>{{ section.settings.added_text }}</p>

        {%- if section.settings.perks != blank -%}
          <ul class="bls__perks">
            {%- assign perks = section.settings.perks | split: '|' -%}
            {%- for p in perks -%}<li>{{ p | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </aside>
    </div>
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('bls-{{ uid }}');
  if(!root) return;

  var moneyFormat = {{ shop.money_format | json }};
  var discount = parseFloat(root.dataset.discount) || 0;
  var code = root.dataset.code || '';
  var bundleTag = root.dataset.bundle || '';
  var state = { top: null, bottom: null };

  function money(cents){
    var v = (cents/100);
    return moneyFormat
      .replace(/\{\{\s*amount\s*\}\}/, v.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','))
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/, Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ','))
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, v.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'))
      .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/, Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.'));
  }

  root.querySelectorAll('[data-size-select]').forEach(function(sel){
    var btn = sel.closest('.bls__card').querySelector('[data-add-to-bundle]');
    sel.addEventListener('change', function(){
      btn.disabled = !sel.value;
    });
  });

  root.querySelectorAll('[data-add-to-bundle]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var card = btn.closest('[data-product]');
      var group = card.dataset.groupName;
      var sel = card.querySelector('[data-size-select]');
      var opt = sel.options[sel.selectedIndex];
      if(!sel.value) return;

      state[group] = {
        id: parseInt(sel.value),
        size: opt.textContent.trim(),
        price: parseInt(opt.dataset.price),
        title: card.dataset.title,
        image: card.dataset.image
      };

      var panel = root.querySelector('[data-group="' + group + '"]');
      panel.querySelectorAll('[data-product]').forEach(function(c){ c.dataset.picked = 'false'; });
      card.dataset.picked = 'true';
      panel.querySelector('[data-selected-note]').textContent = card.dataset.title;

      if(group === 'top' && !state.bottom){
        var size = opt.textContent.trim();
        root.querySelectorAll('[data-group="bottom"] [data-size-select]').forEach(function(bSel){
          for(var i = 0; i < bSel.options.length; i++){
            if(bSel.options[i].textContent.trim() === size && !bSel.options[i].disabled){
              bSel.selectedIndex = i;
              bSel.dispatchEvent(new Event('change'));
              break;
            }
          }
        });
      }

      update();
    });
  });

  ['top','bottom'].forEach(function(group){
    var rmBtn = root.querySelector('[data-slot="' + group + '"] [data-slot-remove]');
    if(!rmBtn) return;
    rmBtn.addEventListener('click', function(){
      state[group] = null;
      var panel = root.querySelector('[data-group="' + group + '"]');
      panel.querySelectorAll('[data-product]').forEach(function(c){ c.dataset.picked = 'false'; });
      panel.querySelectorAll('[data-size-select]').forEach(function(s){ s.selectedIndex = 0; s.dispatchEvent(new Event('change')); });
      panel.querySelector('[data-selected-note]').textContent = {{ section.settings.not_selected_text | json }};
      update();
    });
  });

  function fillSlot(group, emptyText){
    var slot = root.querySelector('[data-slot="' + group + '"]');
    var s = state[group];
    var rm = slot.querySelector('[data-slot-remove]');
    if(s){
      slot.classList.remove('is-empty');
      slot.querySelector('[data-slot-title]').textContent = s.title;
      slot.querySelector('[data-slot-meta]').textContent = s.size + ' · ' + money(s.price);
      if(s.image) slot.querySelector('[data-slot-img]').src = s.image;
      rm.hidden = false;
    } else {
      slot.classList.add('is-empty');
      slot.querySelector('[data-slot-title]').textContent = emptyText;
      slot.querySelector('[data-slot-meta]').textContent = '';
      rm.hidden = true;
    }
  }

  function update(){
    fillSlot('top', {{ section.settings.slot_top_empty | json }});
    fillSlot('bottom', {{ section.settings.slot_bottom_empty | json }});

    var ready = !!(state.top && state.bottom);
    var sub = (state.top ? state.top.price : 0) + (state.bottom ? state.bottom.price : 0);
    var total = Math.round(sub * (1 - discount / 100));

    root.querySelector('[data-subtotal]').textContent = sub ? money(sub) : '—';
    root.querySelector('[data-savings]').textContent = ready ? '− ' + money(sub - total) : '−' + discount + '%';
    root.querySelector('[data-total]').innerHTML = ready
      ? '<span class="bls__was">' + money(sub) + '</span>' + money(total)
      : '—';

    root.querySelector('[data-add]').disabled = !ready;

    var steps = root.querySelectorAll('.bls__step');
    var lines = root.querySelectorAll('.bls__step-line');
    steps.forEach(function(s){ s.classList.remove('is-active','is-done'); });
    lines.forEach(function(l){ l.classList.remove('is-done'); });

    if(!state.top){
      steps[0].classList.add('is-active');
    } else if(!state.bottom){
      steps[0].classList.add('is-done');
      lines[0].classList.add('is-done');
      steps[1].classList.add('is-active');
    } else {
      steps[0].classList.add('is-done');
      steps[1].classList.add('is-done');
      lines[0].classList.add('is-done');
      lines[1].classList.add('is-done');
      steps[2].classList.add('is-active');
    }
  }

  root.querySelector('[data-add]').addEventListener('click', function(){
    if(!state.top || !state.bottom) return;
    var btn = this;
    btn.disabled = true;
    var props = bundleTag ? { '_bundle': bundleTag } : {};
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [
        { id: state.top.id, quantity: 1, properties: props },
        { id: state.bottom.id, quantity: 1, properties: props }
      ]})
    })
    .then(function(r){ return r.json(); })
    .then(function(){
      root.querySelector('[data-done]').hidden = false;
      if(code){ window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=/cart'; }
      else { window.location.href = '/cart'; }
    })
    .catch(function(){ btn.disabled = false; });
  });

  update();
})();
</script>

{% schema %}
{
  "name": "BLS Builder",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Base Layer Set 250" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Choose your top and your bottoms. The bundle discount is applied automatically." },
    { "type": "text", "id": "step1_label", "label": "Step 1 label", "default": "Select top" },
    { "type": "text", "id": "step2_label", "label": "Step 2 label", "default": "Select bottom" },
    { "type": "text", "id": "step3_label", "label": "Step 3 label", "default": "Add to cart" },
    { "type": "text", "id": "step1_title", "label": "Step 1 title", "default": "Choose top" },
    { "type": "text", "id": "step2_title", "label": "Step 2 title", "default": "Choose bottom" },
    { "type": "text", "id": "size_label", "label": "Size dropdown placeholder", "default": "Select Size" },
