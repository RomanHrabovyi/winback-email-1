{%- comment -%}
  ============================================================
  BLS HUB — "Build Your Set" chooser (165 / 250 / 320)
  Merino.tech UK / merinotech.co.uk
  Used on the two landing pages (women's and men's).
  ============================================================
{%- endcomment -%}

<style>
  .blsh{--h-ink:#111;--h-muted:#6b7280;--h-line:#e5e7eb;--h-soft:#f7f7f5;--h-good:#1f7a4d;color:var(--h-ink);}
  .blsh *{box-sizing:border-box;}
  .blsh__wrap{max-width:1240px;margin:0 auto;padding:36px 16px 64px;}
  .blsh__title{font-size:clamp(26px,3.4vw,40px);line-height:1.12;margin:0 0 8px;text-align:center;}
  .blsh__sub{margin:0 auto 34px;text-align:center;color:var(--h-muted);max-width:56ch;}
  .blsh__cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;}
  .blsh__card{display:flex;flex-direction:column;border:1px solid var(--h-line);border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:inherit;}
  .blsh__card:hover{border-color:#c9c9c9;}
  .blsh__media{aspect-ratio:4/3;background:var(--h-soft);position:relative;}
  .blsh__media img{width:100%;height:100%;object-fit:cover;display:block;}
  .blsh__flag{position:absolute;top:12px;left:12px;background:#111;color:#fff;font-size:11px;letter-spacing:.04em;padding:5px 9px;border-radius:4px;}
  .blsh__body{padding:20px;display:flex;flex-direction:column;gap:10px;flex:1;}
  .blsh__gsm{font-size:24px;font-weight:700;line-height:1;}
  .blsh__weight{font-size:13px;color:var(--h-muted);}
  .blsh__tags{display:flex;gap:6px;flex-wrap:wrap;}
  .blsh__tag{font-size:12px;border:1px solid var(--h-line);border-radius:999px;padding:3px 10px;color:var(--h-muted);}
  .blsh__save{font-size:13px;font-weight:600;color:var(--h-good);}
  .blsh__desc{font-size:14px;line-height:1.5;color:var(--h-muted);margin:0;}
  .blsh__cta{margin-top:auto;display:inline-block;text-align:center;padding:13px 16px;border-radius:8px;background:#111;color:#fff;font-weight:600;font-size:14px;}
  .blsh__card:hover .blsh__cta{background:#000;}
  @media (max-width:900px){.blsh__cards{grid-template-columns:1fr;}}
</style>

<section class="blsh">
  <div class="blsh__wrap">
    <h1 class="blsh__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="blsh__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="blsh__cards">
      {%- for block in section.blocks -%}
        <a class="blsh__card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="blsh__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}"
                   srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
                   sizes="(max-width:900px) 92vw, 30vw"
                   alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="800" height="600">
            {%- endif -%}
            {%- if block.settings.flag != blank -%}
              <span class="blsh__flag">{{ block.settings.flag }}</span>
            {%- endif -%}
          </div>
          <div class="blsh__body">
            <div>
              <div class="blsh__gsm">{{ block.settings.gsm }}</div>
              <div class="blsh__weight">{{ block.settings.weight }}</div>
            </div>
            {%- if block.settings.tags != blank -%}
              <div class="blsh__tags">
                {%- assign tags = block.settings.tags | split: ',' -%}
                {%- for t in tags -%}<span class="blsh__tag">{{ t | strip }}</span>{%- endfor -%}
              </div>
            {%- endif -%}
            {%- if block.settings.save != blank -%}
              <div class="blsh__save">{{ block.settings.save }}</div>
            {%- endif -%}
            <p class="blsh__desc">{{ block.settings.description }}</p>
            <span class="blsh__cta">{{ block.settings.cta }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BLS Hub",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Women's base layer sets" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick your weight, pick your pieces, save 15% on every set." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Weight card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "flag", "label": "Corner label", "info": "e.g. Best seller. Leave empty to hide." },
        { "type": "text", "id": "gsm", "label": "GSM", "default": "250 GSM" },
        { "type": "text", "id": "weight", "label": "Weight name", "default": "Midweight" },
        { "type": "text", "id": "tags", "label": "Tags (comma separated)", "default": "Versatile, Skiing, Hiking" },
        { "type": "text", "id": "save", "label": "Saving line", "default": "Save 15%" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "The all-rounder. The right balance of warmth for cold British winter days." },
        { "type": "text", "id": "cta", "label": "Button text", "default": "Build your 250 set" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "BLS Hub",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}

